#version 450
/*
 * NRR kernel: the temporal accumulator's blend, interleaved RGB fp32 -> interleaved RGB fp32.
 *
 * Contract - the runtime's rule AND the runtime's layout, not a similar-looking one:
 *   current  : element_count floats, R,G,B per pixel (interleaved) - the frame about to be displayed
 *   previous : the same shape, ALREADY warped onto this frame's grid (this kernel does not resample)
 *   out[i]   = (1 - alpha) * current[i] + alpha * previous[i]      for every element i
 *   alpha    : ONE scalar for the whole frame, passed in the push constants.
 *
 * Interleaved rather than plane-major, deliberately: nrr_temporal.cpp's blend_frame() indexes
 * `current[p * channels + c]`, so this layout is what makes the kernel *that* operation instead of one that
 * needs a conversion pass in front of it - and a conversion over the same plane costs about what the
 * arithmetic does, which would leave a partial move worth nothing. The other kernels in this directory are
 * NCHW because the *tensors* are; this one mirrors the accumulator, which is the thing it replaces.
 *
 * Why the alpha is a scalar and not a per-pixel decay, which is what this kernel used to compute:
 * that was a different policy. The frame's alpha comes from the *scene's* motion through
 * TEMPORAL_ALPHA_MOTION_GATE_PX / _FULL_PX in nrr_temporal.h - a property of the scene, not of a pixel - and
 * the per-pixel `alpha_base * (1 - clamp(|motion| / threshold))` this shader used to evaluate was therefore
 * not the frame path's rule. A kernel that does not reproduce the rule cannot be wired into the path: it
 * would change every frame's bytes, and with them every recorded frame hash and every dataset built on one.
 * There is no motion input here at all, which is the honest form of "this is the same rule": a caller cannot
 * pass a field and get a different frame.
 *
 * The guarded blend - a validity mask with a (2*TEMPORAL_CLAMP_RADIUS+1)^2 neighbourhood clamp on the
 * history - is deliberately NOT here. It is the path a model that declares `validity` takes, and it needs
 * the mask and the clamp's min/max over the current frame, so it stays on the CPU until it is written and
 * tested as its own kernel rather than approximated by this one.
 */
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Current { float current_values[]; };
layout(std430, binding = 1) readonly buffer Previous { float previous_values[]; };
layout(std430, binding = 2) writeonly buffer Dest { float out_values[]; };
/* One partial sum per workgroup, of |blended - current| - the blend's own `mean_abs_delta`, which
 * nrr_temporal.cpp's blend_frame() reports as TemporalBlendStats::mean_abs_delta and the frame path turns into
 * displayed_delta. It is computed here because the pass that produced it on the CPU was a second full read of
 * the same two planes (~5 ms at this tier) and this kernel has both of them in registers already.
 *
 * A two-stage reduction, deliberately: the workgroup sums its own band through shared memory, and the caller
 * adds the few thousand partials on the host. GLSL 4.50 has no float atomics without an extension, so the
 * alternative is a second kernel - and the sum's order is not the CPU's either way, which is why the caller
 * compares it against the CPU's statistic with a tolerance rather than by equality (see the test). */
layout(std430, binding = 3) writeonly buffer Partials { float partial_sums[]; };

layout(push_constant) uniform Params {
    /* The element count is all the geometry the rule needs: with a fixed three channels and an interleaved
     * layout, an element index carries its own plane and pixel, so there is no stride to be got wrong. */
    uint element_count;
    float alpha;
} params;

shared float band[64];

void main() {
    const uint index = gl_GlobalInvocationID.x;
    const uint local = gl_LocalInvocationID.x;

    /* Out-of-range threads write nothing and contribute nothing - but they still reach every barrier below.
     * Returning early here was the first version of this kernel and it is a deadlock, not a saving: the other
     * invocations in the workgroup wait for a barrier this one would never reach. */
    const bool in_range = index < params.element_count;
    float delta = 0.0;
    if (in_range) {
        const float blended = (1.0 - params.alpha) * current_values[index] +
                              params.alpha * previous_values[index];
        out_values[index] = blended;
        delta = abs(blended - current_values[index]);
    }

    band[local] = delta;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (local < stride) band[local] += band[local + stride];
        barrier();
    }
    if (local == 0u) partial_sums[gl_WorkGroupID.x] = band[0];
}
