+	// NRR bridge (see modules/nrr_dlss_bridge): what the last *evaluated* frame was handed, so a
+	// consumer outside the renderer can pick up the same jitter and velocity field DLSS is being
+	// given instead of having to synthesise them or estimate them from pixels.
+	//
+	// A copy of the values, deliberately, not a pointer to the context: the context is owned by a
+	// render buffer (RenderForwardClustered::RenderBufferDataForwardClustered::dlss_context) and is
+	// memdelete'd with it, so a pointer would dangle. The RIDs go invalid instead of dangling, and
+	// the reader checks them.
+	struct LastFrame {
+		bool valid = false;
+		Size2i internal_size;
+		RID velocity;
+		Vector2 jitter;
+		float delta_time = 0.0f;
+		uint64_t frame = 0;
+	};
+	static LastFrame get_last_frame();
+
 	DLSSEffect();
