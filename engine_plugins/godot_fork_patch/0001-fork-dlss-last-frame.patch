 uint32_t RenderSceneBuffersRD::get_velocity_usage_bits(bool p_resolve, bool p_msaa, bool p_storage) {
-	return get_color_usage_bits(p_resolve, p_msaa, p_storage);
+	// The colour bits do not include a readback for the non-MSAA, non-resolve case this buffer
+	// normally takes, so the field could not be copied out of device memory. That matters beyond
+	// debugging: DLSS is handed exactly these vectors, and a consumer outside the renderer (see
+	// modules/nrr_dlss_bridge) is handed the same field instead of estimating one from pixels.
+	// FSR2's RD back-end sets the same bit for every UAV resource it is given
+	// (effects/fsr2.cpp, ffx_usage_to_rd_usage_flags), so reading a motion-vector field back is
+	// in line with that path rather than a new idea.
+	return get_color_usage_bits(p_resolve, p_msaa, p_storage) | RD::TEXTURE_USAGE_CAN_COPY_FROM_BIT;
 }
 
