#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_nrr_dlss_bridge = env_modules.Clone()

# Godot source files.
#
# SCons collects a module through this file, so a module without an SCsub is silently skipped - the build
# succeeds and the module is simply absent, which is a failure mode worth naming because "the build passed"
# is not evidence that the module is in it.
#
# The sources compile in any tree: the bridge detects the fork's DLSS effect with __has_include and reports
# itself unavailable when that header does not exist (stock Godot), so there is no platform or engine-flag
# condition to express here.
env_nrr_dlss_bridge.add_source_files(env.modules_sources, "*.cpp")
