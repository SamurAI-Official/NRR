# Build artifacts
build/
build-*/
out/
*.exe
*.dll
*.pdb
*.lib
*.exp
*.obj
*.o
*.a
*.so
*.dylib

# Third-party SDKs (fetched via tools/fetch_ort.ps1)
third_party/

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Temp/scratch files
_*
*.tmp
*.log
# Scratch output from one-off tool runs (e.g. tools/evaluate_model.py --out work/...)
work/


# Runtime-generated reference fixtures (written by test_nrr_reference)
test_*.nrrref

# Godot addon build output (see engine_plugins/godot/README.md): the GDExtension
# libraries are built per platform/architecture and are never committed.
engine_plugins/godot/bin/
*.wasm

# Training pairs are generated, not sources: tools/gen_training_pairs.py reproduces them from a seed
# plus this manifest, so the .npz files are build output rather than committed data.
models/training-data/
# Per-run training reports: regenerated by tools/train_nrr.py from the dataset and the seed, and the
# numbers that matter are also recorded in CHANGELOG.md where a reader will find them.
models/*.report.json
# Stage comparison runs: logs, exported graphs and reports from a sweep of configurations. Regenerated by
# re-running the configurations; the numbers are recorded where they are read.
models/stage4/
models/stage4b/
models/noise/
models/noise-warmup/
models/frontier/
models/work/
# P3 quality-lever runs (see docs/evaluation-protocol.md): regenerated by tools/train_nrr.py.
models/p3/
# P4 temporal runs on the jittered godot-v4 dataset: regenerated the same way.
models/p4/
# P5 runs: the godot-v2 reliability verification and the jitter-aware temporal arm, same rationale.
models/p5/

# The Unity verification project (engine_plugins/unity_verify). Library/ is Unity's imported-asset cache
# and measured 1.4 GB here; Unity rebuilds it on first open, so it is generated state and not source.
# ProjectSettings/, Packages/ and the .meta files *are* source - a .meta carries the GUID that asset
# references resolve through - so they stay committed while these do not.
engine_plugins/unity_verify/Library/
engine_plugins/unity_verify/Temp/
engine_plugins/unity_verify/Logs/
engine_plugins/unity_verify/obj/
engine_plugins/unity_verify/UserSettings/
engine_plugins/unity_verify/Build/
engine_plugins/unity_verify/Builds/
# Unity and the IDE regenerate these from the project files.
engine_plugins/unity_verify/*.csproj
engine_plugins/unity_verify/*.sln
engine_plugins/unity_verify/*.user

